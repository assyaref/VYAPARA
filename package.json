{
  "name": "vyapara-desktop",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "electron",
      "react",
      "react-dom",
      "typescript"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p apps/desktop/tsconfig.electron.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "cd apps/desktop && npm run build",
    "build:electron": "cd apps/desktop && npm run electron:build",
    "build:installer": "node scripts/build-installer.mjs",
    "preview": "cd apps/desktop && npm run preview",
    "dev": "cd apps/desktop && npm run dev",
    "electron:dev": "cd apps/desktop && npm run electron:dev",
    "electron:build": "cd apps/desktop && npm run electron:build",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-AuthenticodeSignature (Get-ChildItem apps/desktop/release/*.exe).FullName | Format-List; Get-FileHash apps/desktop/release/*.exe -Algorithm SHA256 | Format-List\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^1.2.0",
    "autoprefixer": "^10.4.16",
    "drizzle-orm": "^0.45.4",
    "electron": "^45.3.1",
    "electron-vite": "^6.0.0",
    "eslint": "^9.21.2",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^6.1.0",
    "postcss": "^8.4.33",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1",
    "unbuild": "^3.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}