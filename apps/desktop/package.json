{
  "name": "vyapara-desktop-app",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "VYAPARA — Point of Sale desktop application for retail/ATK/printing businesses",
  "author": "VYAPARA",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "electron-pos-printer": "^1.4.0",
    "electron-updater": "^6.8.11",
    "jsbarcode": "^3.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^1.2.0",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9.21.2",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^6.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "id.vyapara.desktop",
    "productName": "VYAPARA",
    "electronDist": "../../node_modules/electron/dist",
    "electronVersion": "45.3.1",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "dist/**",
      "assets/brand/**",
      "drizzle/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/vyapara-icon.png",
      "artifactName": "VYAPARA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer/uninstall-cleanup.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "assyaref",
        "repo": "VYAPARA",
        "releaseType": "release"
      }
    ]
  }
}
