# VYAPARA sync server — copy to .env and fill in before deploying.
# Never commit the real .env.

# Required: enrollment secret shared with point-of-sale enrollments (>= 16 chars).
SYNC_ENROLLMENT_SECRET=change-me-min-16-chars

# Required for the admin endpoints (/admin/* on the sync server). Keep long & random.
SYNC_ADMIN_TOKEN=change-me-also-long-and-random

# Port the sync server listens on (container) — published by nginx/reverse proxy.
PORT=8787

# SQLite database path inside the container (volume mount).
SYNC_DB_PATH=/data/sync-server.db

# Optional: token TTL in hours for newly issued device tokens (default 30 days).
# TOKEN_TTL_HOURS=720

# Optional: device name prefix
# DEVICE_NAME_PREFIX=VYAPARA
